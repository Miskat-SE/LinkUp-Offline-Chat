  "fixed_sql": [
    {
      "name": "messages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"messages\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"message_id\" TEXT NOT NULL UNIQUE, \"conversation_id\" TEXT NOT NULL, \"peer_name\" TEXT NOT NULL, \"direction\" TEXT NOT NULL, \"body\" TEXT NOT NULL, \"reply_to_id\" TEXT NULL, \"sent_at\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"status\" TEXT NOT NULL, \"is_read\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_read\" IN (0, 1)), \"receipt_sent\" TEXT NOT NULL DEFAULT 'none', \"attempts\" INTEGER NOT NULL DEFAULT 0, \"last_attempt_at\" INTEGER NULL);"
        }
      ]
    },
