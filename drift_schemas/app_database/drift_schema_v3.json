  "fixed_sql": [
    {
      "name": "messages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"messages\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"message_id\" TEXT NOT NULL UNIQUE, \"conversation_id\" TEXT NOT NULL, \"peer_name\" TEXT NOT NULL, \"direction\" TEXT NOT NULL, \"kind\" TEXT NOT NULL DEFAULT 'text', \"body\" TEXT NOT NULL, \"file_id\" TEXT NULL, \"audience\" TEXT NOT NULL DEFAULT 'direct', \"sender_id\" TEXT NULL, \"reply_to_id\" TEXT NULL, \"sent_at\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"status\" TEXT NOT NULL, \"is_read\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_read\" IN (0, 1)), \"receipt_sent\" TEXT NOT NULL DEFAULT 'none', \"attempts\" INTEGER NOT NULL DEFAULT 0, \"last_attempt_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "files",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"files\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"file_id\" TEXT NOT NULL UNIQUE, \"message_id\" TEXT NOT NULL, \"peer_id\" TEXT NOT NULL, \"direction\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"mime_type\" TEXT NOT NULL, \"size\" INTEGER NOT NULL, \"bytes_transferred\" INTEGER NOT NULL DEFAULT 0, \"status\" TEXT NOT NULL, \"sha256\" TEXT NULL, \"local_path\" TEXT NULL, \"error\" TEXT NULL, \"attempts\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "message_recipients",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"message_recipients\" (\"message_id\" TEXT NOT NULL, \"recipient_id\" TEXT NOT NULL, \"recipient_name\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"attempts\" INTEGER NOT NULL DEFAULT 0, \"file_id\" TEXT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"message_id\", \"recipient_id\"));"
        }
      ]
    },
    {
      "name": "messages_by_chat",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX messages_by_chat ON messages (conversation_id, created_at)"
        }
      ]
    },
    {
      "name": "messages_by_status",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX messages_by_status ON messages (status)"
        }
      ]
    },
    {
      "name": "messages_unread",
